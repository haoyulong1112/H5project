.container
    width: 100%;
    height: 100%;
    overflow: auto;
    box-sizing: border-box;
    background: #C5E5FB;
.title{
    width: 388px;
    height: 96px;
    background: #64C1FF;
    border: 4px solid #40B2FF;
    border-radius: 0 0 30px 30px
    text-align: center;
    line-height: 96px;
    font-size: 32px;
    font-family: PingFang SC-Medium, PingFang SC;
    font-weight: 500;
    color: #FFFFFF;
    margin: 0 auto;
}
.content{
    width: 944px;
    background: #FFFFFF;
    border-radius: 24px;
    margin: 32px auto;
    box-sizing: border-box;
    padding: 40px;
}