.container
    width: 100%;
    height: 100%;
    background: #F7F4F1;
    // padding: 0 0.4rem;
    box-sizing: border-box;
.content
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: flex-start;
    flex-direction: column;
    background: #FF3D45;
    > .content_item
        width: 100%;
        position: relative;
        > .invitebtn
            width: 2.96rem;
            height: .76rem;
            position: absolute;
            top: 3.65rem;
            left: 50%;
            margin-left: -1.45rem;
        > .firendlist
            width: 6.82rem;
            height: 7rem;
            background: #fff;
            position: absolute;
            top: 1.65rem;
            left: 50%;
            margin-left: -3.41rem;
            overflow-y: auto;
            > .firendlist_item
                width: 100%;
                display: flex;
                justify-content: space-between;
                align-items: center;
                box-sizing: border-box;
                padding: 0 .3rem;
                margin-bottom: .4rem;
                > .item_left
                    display: flex;
                    justify-content: flex-start;
                    align-items: center
                    > div:nth-child(1)
                        font-size: .32rem;
                        font-family: PingFangSC-Medium, PingFang SC;
                        font-weight: 500;
                        color: #000000;
                        margin-right: .2rem;
                    > div:nth-child(2)
                        display: flex;
                        align-items: center;
                        > img
                            width: .88rem;
                            height: .88rem;
                            border: .01rem solid #FF7C7C;
                            border-radius: 50%;
                            margin-right: .3rem;
                        > div
                            font-size: .28rem;
                            font-family: PingFangSC-Regular, PingFang SC;
                            font-weight: 400;
                            color: #000000;
                > div:last-of-type
                    font-size: .26rem;
                    font-family: PingFangSC-Regular, PingFang SC;
                    font-weight: 400;
                    color: #E74159;
        > .bgc
            width: 100%
.loginform
    position: absolute
    width: 6.90rem;
    height: 4.3rem;
    background: #FEFFFF;
    box-shadow: 0 .08rem .16rem 0 rgba(178, 16, 40, 0.51);
    border-radius: .20rem;
    top: 6rem;
    left: 50%;
    margin-left: -3.45rem
    padding-top: .1rem
    box-sizing: border-box;
    font-size: .30rem;
    font-family: PingFangSC-Regular, PingFang SC;
    font-weight: 400;
    color: #C9C9C9;
    > .loginbtn
        width: 6.30rem;
        height: .98rem;
        background: #FFAD76;
        border-radius: .20rem;
        font-size: .36rem;
        font-family: PingFangSC-Medium, PingFang SC;
        font-weight: 500;
        color: rgba(255,255,255,.4);
        line-height: .98rem;
        text-align: center;
        margin: .3rem auto;
    > .loginbtn.canbtn
        color: #fff;
    > .formitem.code
        display: flex;
        justify-content: space-between;
        align-content: center;
    > .formitem
        width: 6.30rem;
        height: .96rem;
        background: #F3F4F6;
        border-radius: .20rem;
        margin: .3rem auto;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        padding: 0 .40rem;
        box-sizing: border-box;
        > input
            width: 3.5rem;
            height: 100%;
            background-color: #F3F4F6;
            font-size: .36rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: #000000;
        > input::placeholder
            color: #C9C9C9;
            font-size: .3rem;
        > .phone
            font-size: .34rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: #000000;
            margin-right: .7rem;
            height: 100%;
            line-height: .96rem;
        > .code
            font-size: .30rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: #C9C9C9;
            margin-left: .4rem;
            height: 100%;
            line-height: .96rem;
        > .code.hascode
            font-size: .30rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: #FF5953;


.mask
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.6);
    position: fixed;
    top: 0;
    left: 0;
    > img
        display: block;
        width: 5.3rem;
        height: 3.42rem;
        position: absolute;
        top: .8rem;
        right: .3rem
